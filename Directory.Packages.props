<Project>

  <!-- Enable Central Package Management. Kept first, and as the ONLY place this property name appears in the
       file, so a static analyzer (e.g. OpenSSF Scorecard's Pinned-Dependencies parser) reads the intended
       "true" and never a value mentioned in prose below. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!--
    Central Package Management (CPM). One source of truth for every NuGet version in the repository: projects
    declare <PackageReference Include="..." /> WITHOUT a Version, and the version is resolved from the matching
    <PackageVersion> below. This keeps versions consistent across the projects and makes the `dotnet restore`
    steps in ci.yml / release.yml reproducible — which is also what OpenSSF Scorecard's Pinned-Dependencies
    check rewards (an unpinned restore otherwise caps that check below 10, via "nugetCommand not pinned").

    Two deliberate exceptions:
      * JustDummies.Analyzers pins Microsoft.CodeAnalysis.CSharp to $(RoslynFloorVersion) via a
        VersionOverride, so the load-contract floor stays property-driven and independent of the (newer)
        central version the analyzer test project consumes.
      * tools/justdummies-check/JustDummiesCheck.csproj opts OUT of CPM in its own project file: it consumes
        the JustDummies package at a dynamic $(JustDummiesCheckVersion) and is built in isolation, outside
        the solution.

    The version list is the FirstClassErrors list narrowed to what JustDummies actually restores. AngleSharp,
    BenchmarkDotNet, NSubstitute, Spectre.Console.Cli and Verify.XunitV3 were dropped: no project in this
    repository referenced them. Spectre.Console.Cli has since come back, with JustDummies.Cli; the other four
    are still absent.
  -->

  <ItemGroup>
    <!-- The two guard libraries S5.3 reads by resolved symbol (ADR-0086). Test-only, pinned: every mapped
         row's semantics — which values a helper rejects, each bound's inclusivity, that it returns its
         input — was measured against exactly these versions, and the corpus draws against them. Bumping one
         means re-running those measurements, not just the restore. -->
    <PackageVersion Include="Ardalis.GuardClauses" Version="5.0.0" />
    <PackageVersion Include="CommunityToolkit.Diagnostics" Version="8.4.2" />
    <PackageVersion Include="coverlet.MTP" Version="10.0.1" />
    <!-- The foundation. Referenced by JustDummies.DiagnosticCatalog WITHOUT PrivateAssets, deliberately: a
         package that PUBLISHES a catalogue must let the foundation reach its consumers, since it carries both the
         markers the declarations wear and the DCAT analyzers that check a consumer's suppressions (ADR-0052). -->
    <PackageVersion Include="DiagnosticCatalog" Version="1.0.1" />
    <!-- The catalogues behind every [SuppressMessage] in this repository. DiagnosticCatalog.Sonar mirrors
         SonarAnalyzer.CSharp 10.31.0.145097 — the exact version pinned below, which is what makes the constants
         describe the rules this build actually runs. Bumping one asks for the other to follow (ADR-0050). -->
    <PackageVersion Include="DiagnosticCatalog.NetAnalyzers" Version="1.0.0" />
    <PackageVersion Include="DiagnosticCatalog.Sonar" Version="1.0.0" />
    <PackageVersion Include="FsCheck" Version="3.4.0" />
    <PackageVersion Include="JetBrains.Annotations" Version="2026.2.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
    <!-- The dum tool's project loading (§11.1), JustDummies.Cli only. Workspaces.MSBuild is kept at the same
         version as Microsoft.CodeAnalysis.CSharp above: the two ship together and a workspace built against a
         different Roslyn than the compilation it produces is the classic way this fails at run time. The
         engine takes neither — it is handed a Compilation and knows nothing of MSBuild (ADR-0065). -->
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.6.0" />
    <!-- The C# half of the workspace layer, and not optional: without it a workspace opens the project,
         reports no error, and then answers null when asked for its compilation — because the service that
         builds one is a LANGUAGE service, and Workspaces.MSBuild carries only the language-neutral ones. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.6.0" />
    <PackageVersion Include="Microsoft.Build.Locator" Version="1.11.2" />
    <!-- Compiled against, never shipped beside the tool. Workspaces.MSBuild brings this one in as a runtime
         asset, and Microsoft.Build.Locator refuses that arrangement by design (MSBL001): a tool carrying its
         own copy of an MSBuild assembly loads it instead of the SDK's, and then fails at run time in ways
         that name nothing. JustDummies.Cli therefore takes it with ExcludeAssets="runtime", at the version
         Workspaces.MSBuild resolves — the number is matched to that dependency, not chosen. -->
    <PackageVersion Include="Microsoft.Build.Framework" Version="17.11.48" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" />
    <PackageVersion Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" />
    <PackageVersion Include="Microsoft.Sbom.Targets" Version="4.1.5" />
    <PackageVersion Include="NFluent" Version="3.1.0" />
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.33.0.1635" />
    <PackageVersion Include="StyleCop.Analyzers" Version="1.2.0-beta.556" />
    <!-- The dum tool's command line: JustDummies.Cli owns the command definitions and settings, and the
         engine owns none of it (specification §10.2). Restored to this list when that project arrived —
         it was dropped at the extraction because nothing referenced it then, which is what the note above
         records. -->
    <PackageVersion Include="Spectre.Console.Cli" Version="0.55.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.0" />
    <PackageVersion Include="xunit.v3.extensibility.core" Version="4.0.0" />
  </ItemGroup>

</Project>
