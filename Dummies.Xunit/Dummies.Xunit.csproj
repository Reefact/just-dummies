<Project Sdk="Microsoft.NET.Sdk">

  <!-- Committed public-API baseline + package validation (see build/PublicApiBaseline.props). A single
       netstandard2.0 subfolder: this package has one surface, unlike Dummies' two divergent legs. -->
  <Import Project="..\build\PublicApiBaseline.props" />

  <PropertyGroup>
    <!-- Build. netstandard2.0, the same floor Dummies keeps: the adapter compiles against
         xunit.v3.extensibility.core, which is itself a netstandard2.0 library, so nothing forces this
         package above the floor its own dependency and ADR-0022 already establish. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- XML documentation -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Version. Local/dev fallback only: release.yml overrides it with -p:Version from the Git tag of the
         dum release train (dum-v*, see tools/packaging/pack.sh), which this package rides with Dummies. -->
    <Version>0.1.0-dev</Version>

    <!-- NuGet identity -->
    <PackageId>Dummies.Xunit</PackageId>
    <Authors>Sylvain AURAT</Authors>
    <Company>Reefact</Company>

    <!-- Description -->
    <Description>
      The xUnit v3 companion of Dummies: mark a test, a class or an assembly [Reproducible] and its arbitrary values are drawn from a pinned seed, reported only when the test fails. Removes the per-test Any.Reproducibly ceremony without changing how values are generated.
    </Description>

    <!-- Metadata -->
    <PackageTags>testing;test-data;dummies;arbitrary;xunit;xunit-v3;deterministic;seed;reproducible</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>

    <!-- Links -->
    <PackageProjectUrl>https://github.com/Reefact/first-class-errors</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Reefact/first-class-errors.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <Copyright>© Reefact 2026</Copyright>

    <!-- Package assets -->
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\icon.png" Pack="true" PackagePath="/" />
    <None Include="README.nuget.md" Pack="true" PackagePath="readme.md" />
  </ItemGroup>

  <ItemGroup>
    <!-- The "report only on failure" rule is decided from the finished test's outcome, which only the
         framework can produce. Exposing the decision itself lets the rule be proved without a test that has
         to fail for real. -->
    <InternalsVisibleTo Include="Dummies.Xunit.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The extensibility package, not the xunit.v3 metapackage: this is a library contributing an
         attribute, not a test project that needs an assertion library or a runner. -->
    <PackageReference Include="xunit.v3.extensibility.core" />
  </ItemGroup>

  <ItemGroup>
    <!-- Dummies only. This package exists precisely because Dummies cannot reference a test framework
         itself (ADR-0011); it must not acquire a FirstClassErrors dependency either. -->
    <ProjectReference Include="..\Dummies\Dummies.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embed an SPDX SBOM inside the package at pack time, as Dummies does, so the inventory of files and
         dependencies travels with the artifact. Build-time only: never a consumer-visible dependency. -->
    <PackageReference Include="Microsoft.Sbom.Targets" PrivateAssets="all" />
  </ItemGroup>

</Project>
