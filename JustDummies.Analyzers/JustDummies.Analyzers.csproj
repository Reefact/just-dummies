<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Analyzers must target netstandard2.0 so they load in every Roslyn host. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- Roslyn analyzer development guidance (RSxxxx rules, release tracking). -->
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>

    <!-- Packed into the JustDummies NuGet package (analyzers/dotnet/cs) in a later step, not shipped on its own. -->
    <IsPackable>false</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
  </PropertyGroup>

  <ItemGroup>
    <!-- LOAD CONTRACT — do not bump. Microsoft.CodeAnalysis.CSharp is pinned to $(RoslynFloorVersion), the minimum
         Roslyn (host compiler) able to load the shipped analyzer: it is packed inside JustDummies and loaded by each
         consumer's compiler, so a higher version makes it silently fail to load (CS8032) on older SDKs/IDEs. The floor
         lives once in Directory.Build.props. Microsoft.CodeAnalysis.Analyzers is only a build-time authoring analyzer
         (PrivateAssets=all), not part of the load contract, so it is free to move. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="$(RoslynFloorVersion)" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- The catalogue this analyzer's descriptors read their id, category, title and help link FROM (ADR-0052).
         That is the loop only a first-party catalogue can close: the rule this analyzer REPORTS and the rule a
         consumer SILENCES become the same value by construction, rather than two transcriptions of one string
         that nothing compares.

         PrivateAssets="all" because this project is never packed on its own — its DLL is carried inside
         JustDummies.nupkg by _AddAnalyzerToPackage — so nothing here may reach that package's dependency graph
         (ADR-0003). It costs nothing at analyzer load time either: the members are const, so the compiler
         substitutes their values and the built analyzer carries no reference left to resolve. -->
    <ProjectReference Include="..\JustDummies.DiagnosticCatalog\JustDummies.DiagnosticCatalog.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Release tracking (RS2008): declared rules live here, verified at build time. -->
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

  <ItemGroup>
    <!-- Surface the floor in the assembly itself so RoslynFloorTests reads the SAME value the pin above
         uses, rather than a copy of it. A test carrying its own literal would keep passing after the
         property moved; reading it back from metadata makes the pin and its guard impossible to diverge. -->
    <AssemblyMetadata Include="RoslynFloorVersion" Value="$(RoslynFloorVersion)" />
  </ItemGroup>

</Project>
