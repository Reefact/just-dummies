<Project Sdk="Microsoft.NET.Sdk">

  <!-- No PublicApiBaseline.props import, unlike the shipping libraries: a tool carries no public-API
       compatibility promise, and its surface is the command line, not a set of types (specification §13.4). -->

  <PropertyGroup>
    <!-- Build. net8.0 with RollForward=Major so the tool runs on any newer runtime the developer has
         installed, rather than demanding the exact band it was built for. Unlike the engine, this project
         is NOT pinned to the Roslyn floor: it hosts its own compiler and hands the resulting Compilation
         down to an engine compiled against an older one, which is the supported direction (§13.2). -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- .NET tool identity. The package is JustDummies.Cli; the command a developer types is `dum`
         (specification §10.4). -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dum</ToolCommandName>

    <!-- Version. A local/dev fallback only: the cli release train overrides it with -p:Version from the
         Git tag (cli-v*, see tools/packaging/pack.sh). Nothing has been published from this number yet;
         the train packs, and no cli-v* tag has been pushed. -->
    <Version>0.1.0-dev</Version>

    <!-- NuGet identity -->
    <PackageId>JustDummies.Cli</PackageId>
    <Authors>Sylvain AURAT</Authors>
    <Company>Reefact</Company>

    <!-- Description -->
    <Description>
      dum, the JustDummies scaffolder: it writes the dummy generator for one of your types, once, as ordinary code you own and edit. It reads your compilation only — it never references JustDummies itself, so the tool and the library version independently.
    </Description>

    <!-- Metadata -->
    <PackageTags>testing;test-data;dummies;scaffolding;dotnet-tool;cli;code-generation</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>

    <!-- Links -->
    <PackageProjectUrl>https://justdummies.io</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Reefact/just-dummies.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <Copyright>© Reefact 2026</Copyright>

    <!-- Package assets. The readme is not decoration on a tool: without PackageReadmeFile the pack emits
         NU5133, and the CI ratchet turns that into an error — which is the right pressure, since a tool
         nobody can read the usage of on its listing page is a tool nobody installs. -->
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- The crash-test dummy, the one mark every package here wears — deliberately not varied per package,
         since a nuget.org listing renders it at 128 px. Icon by Magnific, from Flaticon; the attribution is
         in this package's README. -->
    <None Include="..\icon.png" Pack="true" PackagePath="icon.png" />
    <None Include="README.nuget.md" Pack="true" PackagePath="readme.md" />
  </ItemGroup>

  <ItemGroup>
    <!-- The command line. The shell owns the command definitions and settings; the engine owns none of it and
         must never see them (specification §10.2). -->
    <PackageReference Include="Spectre.Console.Cli" />

    <!-- Project loading (§11.1), and the compiler this shell hosts.

         Microsoft.CodeAnalysis.CSharp is declared here at the CURRENT version, deliberately and in so many
         words: §13.2 has the engine pinned to $(RoslynFloorVersion) so a compiler host can load it, and the
         CLI explicitly NOT bound by that floor because it hosts its own. Leaving it implicit made restore
         meet the engine's transitive 4.8.0 beside this workspace's 5.6.0 and warn (NU1608); saying which
         Roslyn the shell runs on answers that instead of silencing it, and matches what the two projects
         are for. The direction stays the supported one — a newer runtime satisfying an older reference. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" />
    <PackageReference Include="Microsoft.Build.Locator" />

    <!-- Compiled against, never copied: MSBuild's own assemblies must come from the SDK the developer has
         installed, which is the whole point of the locator above. Declared here only because
         Workspaces.MSBuild would otherwise bring it in as a runtime asset, which the locator refuses by
         design (MSBL001). -->
    <PackageReference Include="Microsoft.Build.Framework" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- The engine. No reference to JustDummies accompanies it, here or there: every library symbol the
         tool reasons about is resolved by metadata name against the DEVELOPER's compilation, exactly as
         the analyzers do, which is what makes version skew between tool and library impossible
         (ADR-0063). The packed tool must therefore declare no JustDummies dependency; the release train
         asserts it on the produced .nuspec (§13.6). -->
    <ProjectReference Include="..\JustDummies.GenAny\JustDummies.GenAny.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embed an SPDX SBOM inside the package at pack time, as the three library packages do. It matters
         more here than there: a .NET tool ships its whole dependency closure as files rather than as a
         dependency list, so the nuspec of this package names nothing and the SBOM is the only inventory of
         what a consumer actually installs. Build-time only: never a consumer-visible dependency. -->
    <PackageReference Include="Microsoft.Sbom.Targets" PrivateAssets="all" />
  </ItemGroup>

  <!-- Opens the internals to the shell's own suite: the command line is the tool's contract, and nothing
       outside this assembly is meant to call the code that reads it. -->
  <ItemGroup>
    <InternalsVisibleTo Include="JustDummies.Cli.UnitTests" />
  </ItemGroup>

</Project>
