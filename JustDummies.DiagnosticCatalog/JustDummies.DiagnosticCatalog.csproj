<Project Sdk="Microsoft.NET.Sdk">

  <!-- Committed public-API baseline + package validation (see build/PublicApiBaseline.props). This package is
       ALL public surface and nothing else, so the baseline is not a formality here: it is the diff that shows a
       rule or a member being removed, which is the one change a catalogue must never make. -->
  <Import Project="..\build\PublicApiBaseline.props" />

  <PropertyGroup>
    <!-- Build. netstandard2.0 alone, unlike JustDummies' two legs: this assembly holds constants and nothing
         else, so there is no surface that could differ between a downlevel and a modern target, and a single
         asset reaches every consumer including the .NET Framework 4.7.2 floor (ADR-0007). -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- XML documentation. Load-bearing rather than routine: a rule's Title is reproduced as its documentation
         comment, so hovering JustDummiesRule.JD006 in a consumer's IDE says what the rule is about — which is
         where the prose goes once the suppression stops carrying it. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Version. Local/dev fallback only: release.yml overrides it with -p:Version from the Git tag of the
         catalog release train (catalog-v*, see tools/packaging/pack.sh). Its own train because it versions on
         the JD rule set, which moves when a diagnostic is added — not when the library or the adapter does. -->
    <Version>0.1.0-dev</Version>

    <!-- NuGet identity -->
    <PackageId>JustDummies.DiagnosticCatalog</PackageId>
    <Authors>Sylvain AURAT</Authors>
    <Company>Reefact</Company>

    <!-- Description -->
    <Description>
      The JustDummies analyzer rules (JD001-JD028) as strongly referenced constants, so that SuppressMessageAttribute takes compile-checked references instead of magic strings. Reference it to have your suppressions of JustDummies diagnostics checked and offered a fix.
    </Description>

    <!-- Metadata -->
    <PackageTags>testing;test-data;dummies;analyzers;diagnostics;suppressmessage;code-analysis;catalog</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>

    <!-- Links -->
    <PackageProjectUrl>https://justdummies.io</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Reefact/just-dummies.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <Copyright>© Reefact 2026</Copyright>

    <!-- Package assets -->
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- The library's mark, not the adapter's: this package catalogues the rules JustDummies itself ships. -->
    <None Include="..\icon.png" Pack="true" PackagePath="icon.png" />
    <None Include="README.nuget.md" Pack="true" PackagePath="readme.md" />

    <!-- The opt-in that switches the DCAT checks on for whoever references this catalogue. PackagePath is
         load-bearing: NuGet imports build/<package id>.props and ignores any other name, so a mistake here
         produces a catalogue that checks nobody and reports nothing about it. The file says the rest. -->
    <None Include="DiagnosticCatalogOptIn.props" Pack="true" PackagePath="build/$(PackageId).props" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- The foundation, WITHOUT PrivateAssets="all" — deliberately, and the one place in this repository where
         that is right. A package that PUBLISHES a catalogue must let the foundation reach its consumers: it
         carries the [DiagnosticRule] and [DiagnosticCategory] attributes these declarations are marked with, and
         the DCAT analyzers that check a consumer's suppressions. Hiding it would ship a catalogue that declares
         nothing tooling can see and delivers no checking to whoever referenced it, which is the whole point of
         the package. JustDummies and JustDummies.Xunit keep PrivateAssets="all"; they CONSUME catalogues
         (ADR-0050), they do not publish one. -->
    <PackageReference Include="DiagnosticCatalog" />
  </ItemGroup>

  <!-- The one project here that does NOT run the JustDummies analyzers on itself, and it cannot: those analyzers
       read their descriptors from these constants, so referencing them back would be a build cycle — MSBuild says
       so, as MSB4006 in the restore graph. Nothing is lost that matters. This assembly declares constants and no
       executable statement, so there is no call site for a rule about drawing values to fire on. -->

  <ItemGroup>
    <!-- Embed an SPDX SBOM inside the package at pack time, as the other packages here do, so the inventory of
         files and dependencies travels with the artifact. Build-time only: never a consumer-visible dependency. -->
    <PackageReference Include="Microsoft.Sbom.Targets" PrivateAssets="all" />
  </ItemGroup>

</Project>
