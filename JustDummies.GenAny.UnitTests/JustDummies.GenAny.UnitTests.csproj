<Project Sdk="Microsoft.NET.Sdk">

  <!-- net10.0 only, like JustDummies.Analyzers.UnitTests: this project builds compilations with Roslyn,
       and Microsoft.CodeAnalysis.CSharp does not load on the net472 support floor. Nothing here exercises
       the netstandard2.0 asset, so that floor has nothing to say about it (ADR-0007). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- The CURRENT Roslyn, deliberately not the floor the engine is pinned to: the suite plays the part of
         a host handing a Compilation down, which is the direction §13.2 supports. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NFluent" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JustDummies.GenAny\JustDummies.GenAny.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
