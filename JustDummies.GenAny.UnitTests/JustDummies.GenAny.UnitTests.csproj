<Project Sdk="Microsoft.NET.Sdk">

  <!-- net10.0 only, like JustDummies.Analyzers.UnitTests: this project builds compilations with Roslyn,
       and Microsoft.CodeAnalysis.CSharp does not load on the net472 support floor. Nothing here exercises
       the netstandard2.0 asset, so that floor has nothing to say about it (ADR-0007). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- The CURRENT Roslyn, deliberately not the floor the engine is pinned to: the suite plays the part of
         a host handing a Compilation down, which is the direction §13.2 supports. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NFluent" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JustDummies.GenAny\JustDummies.GenAny.csproj" />

    <!-- The library and its analyzers, as the SUBJECT of EmittedCodeCompilesTests: each golden file is
         compiled against them, and must produce no CS* error and no JD* diagnostic. That the engine may not
         reference JustDummies (ADR-0063) says nothing about this project — the guard is on the engine's own
         assembly, and a test that could not reference the library could not check what the emitted code does
         against it. -->
    <ProjectReference Include="..\JustDummies\JustDummies.csproj" />
    <ProjectReference Include="..\JustDummies.Analyzers\JustDummies.Analyzers.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The approved files are C#, so they read as code in a review and compile in the test that compiles
         them. They are NOT this project's own source: compiling them here would demand the fixture types in
         this assembly, and the TODO golden does not compile by design. -->
    <Compile Remove="Golden\**\*.cs" />
    <None Include="Golden\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The repository root, because the approved files live in the working tree and nothing on the assembly
         can carry them. Baked in here rather than derived from [CallerFilePath], which CI rewrites to /_/
         under the DeterministicSourcePaths that ContinuousIntegrationBuild turns on. -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>RepositoryRoot</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)..</_Parameter2>
    </AssemblyAttribute>

    <!-- The library's OTHER asset, the one a project below .NET 8 resolves. It cannot be found from the
         referenced assembly's own location: what lands beside this project's output is the net8.0 leg,
         copied. Passed as a path so it follows the configuration the suite is built in, and so
         DownlevelAssetTests can prove ADR-0059 with the same parameter and two answers. -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>DownlevelLibrary</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)..\JustDummies\bin\$(Configuration)\netstandard2.0\JustDummies.dll</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
