<Project Sdk="Microsoft.NET.Sdk">

  <!-- Committed public-API baseline + package validation (see build/PublicApiBaseline.props). A single
       netstandard2.0 subfolder: this package has one surface, unlike JustDummies' two divergent legs. -->
  <Import Project="..\build\PublicApiBaseline.props" />

  <PropertyGroup>
    <!-- Build. netstandard2.0, the same floor JustDummies keeps: the adapter compiles against
         xunit.v3.extensibility.core, which is itself a netstandard2.0 library, so nothing forces this
         package above the floor its own dependency and ADR-0007 already establish. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- XML documentation -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Version. Local/dev fallback only: release.yml overrides it with -p:Version from the Git tag of the
         xunit release train (xunit-v*, see tools/packaging/pack.sh). This adapter used to ride the dum-v*
         train together with JustDummies; it now versions independently, so a change to the xUnit binding
         no longer forces a version of the library, and vice versa. -->
    <Version>0.1.0-dev</Version>

    <!-- NuGet identity -->
    <PackageId>JustDummies.Xunit</PackageId>
    <Authors>Sylvain AURAT</Authors>
    <Company>Reefact</Company>

    <!-- Description -->
    <Description>
      The xUnit v3 companion of JustDummies: mark a test, a class or an assembly [Reproducible] and its arbitrary values are drawn from a pinned seed, reported only when the test fails. Removes the per-test Any.Reproducibly ceremony without changing how values are generated.
    </Description>

    <!-- Metadata -->
    <PackageTags>testing;test-data;dummies;arbitrary;xunit;xunit-v3;deterministic;seed;reproducible</PackageTags>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>

    <!-- Links -->
    <PackageProjectUrl>https://justdummies.io</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Reefact/just-dummies.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <Copyright>© Reefact 2026</Copyright>

    <!-- Package assets -->
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- The crash-test dummy, the one mark all three packages wear. Deliberately not varied per package:
         a nuget.org listing renders it at 128 px, where a per-package badge is a few pixels nobody reads,
         and one mark repeated is what makes the three read as one product. Icon by Magnific, from
         Flaticon — the attribution is in this package's README. -->
    <None Include="..\icon.png" Pack="true" PackagePath="icon.png" />
    <None Include="..\LICENSE" Pack="true" PackagePath="/" />
    <None Include="README.nuget.md" Pack="true" PackagePath="readme.md" />
  </ItemGroup>

  <ItemGroup>
    <!-- The "report only on failure" rule is decided from the finished test's outcome, which only the
         framework can produce. Exposing the decision itself lets the rule be proved without a test that has
         to fail for real. -->
    <InternalsVisibleTo Include="JustDummies.Xunit.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The extensibility package, not the xunit.v3 metapackage: this is a library contributing an
         attribute, not a test project that needs an assertion library or a runner. -->
    <PackageReference Include="xunit.v3.extensibility.core" />
  </ItemGroup>

  <ItemGroup>
    <!-- JustDummies only. This package exists precisely because JustDummies cannot reference a test framework
         itself (ADR-0003); it must not acquire a FirstClassErrors dependency either. -->
    <ProjectReference Include="..\JustDummies\JustDummies.csproj" />

    <!-- Run the JustDummies analyzers on this project: the rules this product ships are the rules its own
         code is held to, so a rule that misfires or nags is met here before a consumer meets it.
         OutputItemType=Analyzer loads them at build and in the IDE, ReferenceOutputAssembly=false keeps them
         off the runtime graph, and PrivateAssets=all stops the reference from reaching a consumer of this
         project. -->
    <ProjectReference Include="..\JustDummies.Analyzers\JustDummies.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embed an SPDX SBOM inside the package at pack time, as JustDummies does, so the inventory of files and
         dependencies travels with the artifact. Build-time only: never a consumer-visible dependency. -->
    <PackageReference Include="Microsoft.Sbom.Targets" PrivateAssets="all" />
  </ItemGroup>

  <!-- Decouple the two release trains (ADR-0047).

       By default `dotnet pack` stamps a ProjectReference's dependency at the version the referenced project
       is BUILT with, and the release packs pass -p:Version as a global property, which reaches every project
       in the graph. The adapter packed at 0.2.0 therefore declared a dependency on JustDummies 0.2.0 — a
       version that need not exist — so the two trains could only ever move together. That is the opposite of
       what "independent trains" means.

       _ProjectReferencesWithVersions is NuGet's own hook for the case: it is the item NuGet reads to build the
       nuspec's dependency list, so rewriting the entry here sets the DECLARED dependency without touching what
       is built or referenced. The ProjectReference itself is untouched: local builds, tests, analyzers and the
       IDE keep compiling against the sibling sources.

       tools/packaging/pack.sh passes the last published lib-v* tag. Unset (a plain `dotnet pack`, a local
       build), the default behaviour stands, so nothing about developing here changes. -->
  <Target Name="PinTheJustDummiesDependencyVersion"
          AfterTargets="_GetProjectReferenceVersions"
          Condition="'$(JustDummiesDependencyVersion)' != ''">
    <ItemGroup>
      <_ProjectReferencesWithVersions Condition="'%(Filename)' == 'JustDummies'">
        <ProjectVersion>$(JustDummiesDependencyVersion)</ProjectVersion>
      </_ProjectReferencesWithVersions>
    </ItemGroup>
  </Target>

</Project>
