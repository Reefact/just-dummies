<Project Sdk="Microsoft.NET.Sdk">

  <!-- Committed public-API baseline + package validation (see build/PublicApiBaseline.props).
       The per-TFM subfolders track the two divergent surfaces (net8.0 carries the modern generators). -->
  <Import Project="..\build\PublicApiBaseline.props" />

  <PropertyGroup>
    <!-- Build. netstandard2.0 keeps the widest reach; the net8.0 leg additionally carries the modern
         types that do not exist downlevel (DateOnly, TimeOnly, Int128, UInt128, Half). -->
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- CA1510 asks every `if (x is null) throw new ArgumentNullException(...)` to become
         ArgumentNullException.ThrowIfNull(x). That helper arrived in .NET 6, so the rule only fires on this
         project's MODERN leg while the same source must still compile on the pre-.NET-6 one — and it cannot be
         polyfilled: ThrowIfNull is a static method on an existing BCL type, and C# has no static extension
         methods, so supplying it would mean shadowing System.ArgumentNullException itself. Suppressed for as
         long as this project targets below .NET 6; see ADR-0037. -->
    <NoWarn>$(NoWarn);CA1510</NoWarn>

    <!-- XML documentation -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Version. This is only a local/dev fallback: release.yml overrides it with -p:Version from the
         Git tag of the lib release train (lib-v*, see tools/packaging/pack.sh). The train was called dum-v*
         while this library shared the tag namespace of Reefact/first-class-errors; no dum-v* tag was ever
         pushed, so moving to this repository's own lib-v* train discarded nothing. -->
    <Version>0.1.0-dev</Version>

    <!-- NuGet identity -->
    <PackageId>JustDummies</PackageId>
    <Authors>Sylvain AURAT</Authors>
    <Company>Sylvain Aurat</Company>

    <!-- Description -->
    <Description>
      A fluent DSL for generating arbitrary yet valid test values: dummies. Constraints express the invariants a value must satisfy — never what the test asserts. Conflicting constraints fail fast with clear, actionable exceptions, and any sequential run is reproducible from a reported seed.
    </Description>

    <!-- Metadata -->
    <PackageTags>testing;test-data;dummies;arbitrary;anonymous-values;fluent;deterministic;seed;value-objects;constraints</PackageTags>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>

    <!-- Links -->
    <PackageProjectUrl>https://justdummies.io</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Reefact/just-dummies.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <Copyright>© Sylvain Aurat 2026</Copyright>

    <!-- Package assets -->
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>readme.md</PackageReadmeFile>

    <!-- No PackageReleaseNotes: per-release notes are generated by tools/packaging/release-notes.sh
         and published on the GitHub Release, so a value hardcoded here would go stale on every release. -->

    <!-- No GeneratePackageOnBuild: packages are produced by `dotnet pack` in the release workflow
         (.github/workflows/release.yml), so no local or CI build ever emits a stray .nupkg. -->
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\icon.png" Pack="true" PackagePath="/" />
    <None Include="..\LICENSE" Pack="true" PackagePath="/" />
    <None Include="README.nuget.md" Pack="true" PackagePath="readme.md" />
  </ItemGroup>

  <!-- Opens the internals to the contract suite so the null-argument guard convention (every public/internal member
       validates its non-nullable reference arguments) can be enforced by reflection over the whole surface, including
       the internal boundary (Create factories, internal constructors) the public API can never reach a null through.
       This deliberately relaxes the previously black-box test posture; see ADR-0024. -->
  <ItemGroup>
    <InternalsVisibleTo Include="JustDummies.UnitTests" />
  </ItemGroup>

  <!-- No runtime ProjectReference: JustDummies is a standalone, error-agnostic library. It must never depend on
       FirstClassErrors (or any other project in this repository) at runtime; the boundary is guarded by an
       architecture test in JustDummies.UnitTests. The build-only reference below (ReferenceOutputAssembly=false) is
       the sole exception: it packs the JustDummies analyzers into this package and adds no assembly dependency. -->

  <ItemGroup>
    <!-- Embed an SPDX SBOM (software bill of materials) inside the package at pack time
         (_manifest/spdx_2.2/manifest.spdx.json), so the inventory of files and dependencies travels with
         the artifact and is covered by the release's provenance attestation. Build-time only
         (PrivateAssets=all): consumers never see this as a dependency. -->
    <PackageReference Include="Microsoft.Sbom.Targets" PrivateAssets="all" />
  </ItemGroup>

  <!-- Ship the analyzers inside this package (analyzers/dotnet/cs) so package consumers get them automatically.
       ReferenceOutputAssembly=false + PrivateAssets=all keeps the analyzer off the runtime/dependency graph (the
       standalone-boundary test still passes); the ProjectReference only guarantees the analyzer is built before this
       project is packed. -->
  <ItemGroup>
    <ProjectReference Include="..\JustDummies.Analyzers\JustDummies.Analyzers.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_AddAnalyzerToPackage</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <!-- Analyzers live at a single, non-per-TFM path, so add the DLL once (during the netstandard2.0 pass); adding it
       under TargetsForTfmSpecificContentInPackage without a condition would pack it once per target framework. -->
  <Target Name="_AddAnalyzerToPackage" Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(MSBuildThisFileDirectory)..\JustDummies.Analyzers\bin\$(Configuration)\netstandard2.0\JustDummies.Analyzers.dll">
        <PackagePath>analyzers/dotnet/cs</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>

</Project>
