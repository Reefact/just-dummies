<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Deterministic sources for the floor check. <clear/> drops any inherited (machine/user/repo)
         source so restore behaves the same on a developer box and on the CI runner. local-feed supplies
         the freshly packed JustDummies package (with its bundled analyzers) that the floor job's
         `dotnet pack` step writes here; the path is resolved relative to THIS file, so it is
         tools/floor-check/local-feed regardless of the CWD. nuget.org must stay: on machines whose SDK
         does not bundle the net8.0 targeting packs, restore downloads Microsoft.NETCore.App.Ref & co. as
         packages (NU1101 without it) — but it is barred from supplying JustDummies by the mapping
         below. -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="local-feed" value="./local-feed" />
  </packageSources>
  <packageSourceMapping>
    <!-- Route the JustDummies id EXCLUSIVELY to the local feed. Without this, restore may also ask
         nuget.org for the id, and the package published there could one day be served in place of the one
         this job just packed (the classic substitution / dependency-confusion trap). This is not
         hypothetical here: JustDummies 0.1.0-preview.1 is on nuget.org. With the mapping, nuget.org
         structurally cannot supply it — only the freshly packed .nupkg can. Everything else (e.g. the
         targeting packs above) stays free to come from nuget.org. -->
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="local-feed">
      <package pattern="JustDummies" />
    </packageSource>
  </packageSourceMapping>
</configuration>
