<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- The UX trial consumes the PACKED packages, as a real user does. local-feed is filled by run.sh;
       the JustDummies ids are mapped to it exclusively so nuget.org can never substitute them. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="local-feed" value="./local-feed" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="local-feed">
      <package pattern="JustDummies" />
      <package pattern="JustDummies.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
